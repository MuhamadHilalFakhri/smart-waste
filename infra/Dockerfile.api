FROM node:22-bookworm-slim AS dependencies
WORKDIR /workspace
RUN corepack enable && corepack prepare pnpm@10.32.1 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY services/api/package.json ./services/api/package.json
RUN pnpm install --filter @smart-waste/api --frozen-lockfile
COPY services/api ./services/api

FROM dependencies AS test
WORKDIR /workspace/services/api
CMD ["pnpm", "test:integration"]

FROM dependencies AS build
RUN pnpm --filter @smart-waste/api build

FROM node:22-bookworm-slim AS runtime
ENV NODE_ENV=production HOST=0.0.0.0 PORT=8000
WORKDIR /workspace/services/api
COPY --from=build /workspace /workspace
RUN groupadd -g 999 app && useradd -u 999 -g app app && mkdir -p /data/media && chown -R app:app /data
USER app
EXPOSE 8000
CMD ["sh", "-c", "node dist/cli.js migrate && node dist/cli.js seed-admin && exec node dist/server.js"]
