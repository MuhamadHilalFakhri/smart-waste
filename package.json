{
  "name": "smart-waste",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:web": "pnpm --filter @smart-waste/web dev",
    "dev:mobile": "pnpm --filter @smart-waste/mobile start",
    "build": "pnpm --filter @smart-waste/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "api:generate": "pnpm --filter @smart-waste/api openapi && pnpm --filter @smart-waste/api-client generate",
    "dev:api": "pnpm --filter @smart-waste/api dev"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "prettier": "^3.9.10"
  }
}
